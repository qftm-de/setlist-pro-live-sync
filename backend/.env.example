APP_MODE=core
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
INSTANCE_NAME=
COMMUNITY_URL=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
# true nur hinter TLS-Proxy mit gesetztem X-Forwarded-Proto, sonst false
TRUST_PROXY_HEADERS=false
# Oeffentliche Adresse fuer Links aus Verwaltungskommandos, z.B. https://setlist.example
INSTANZ_BASIS=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
REDIS_URL=
# Private PDF-Ablage im persistenten Volume, außerhalb des Webroots
DOCUMENTS_ROOT=
# 0 schaltet das jeweilige Limit ab
PDF_MAX_UPLOAD_BYTES=20971520
PDF_MAX_PAGES=100
PDF_CHECK_TIMEOUT_SECONDS=30
PDF_CHECK_MEMORY_MB=512
# Obergrenze für den Bandexport in Bytes, 0 schaltet sie ab
EXPORT_MAX_BYTES=536870912
